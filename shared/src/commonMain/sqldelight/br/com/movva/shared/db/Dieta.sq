CREATE TABLE dietaEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    tipoRefeicao TEXT NOT NULL,
    descricao TEXT NOT NULL,
    dataRefeicao TEXT NOT NULL,
    sincronizado INTEGER NOT NULL DEFAULT 0,
    itensJson TEXT NOT NULL DEFAULT '[]'
);

selectDietas:
SELECT * FROM dietaEntity WHERE userId = ? ORDER BY dataRefeicao DESC;

selectNaoSincronizados:
SELECT * FROM dietaEntity WHERE userId = ? AND sincronizado = 0;

upsertDieta:
INSERT OR REPLACE INTO dietaEntity (id, userId, tipoRefeicao, descricao, dataRefeicao, sincronizado, itensJson)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectDietaPorId:
SELECT * FROM dietaEntity WHERE userId = ? AND id = ?;

selectDietasDoDia:
SELECT * FROM dietaEntity WHERE userId = ? AND dataRefeicao = ?;

marcarSincronizado:
UPDATE dietaEntity SET sincronizado = 1 WHERE id = ?;