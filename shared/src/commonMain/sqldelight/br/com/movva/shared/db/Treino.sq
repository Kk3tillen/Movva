CREATE TABLE treinoEntity (
    id TEXT NOT NULL PRIMARY KEY,
    userId TEXT NOT NULL,
    nome TEXT NOT NULL,
    tipo TEXT NOT NULL,
    duracaoMin INTEGER,
    dataTreino TEXT NOT NULL,
    observacoes TEXT,
    sincronizado INTEGER NOT NULL DEFAULT 0
);

selectTreinos:
SELECT * FROM treinoEntity WHERE userId = ? ORDER BY dataTreino DESC;

selectNaoSincronizados:
SELECT * FROM treinoEntity WHERE userId = ? AND sincronizado = 0;

upsertTreino:
INSERT OR REPLACE INTO treinoEntity (id, userId, nome, tipo, duracaoMin, dataTreino, observacoes, sincronizado)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

marcarSincronizado:
UPDATE treinoEntity SET sincronizado = 1 WHERE id = ?;